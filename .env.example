# Copy to .env — never commit .env. Validated at boot by src/server/env.ts (S8).
DATABASE_URL="postgresql://huk:huk@localhost:5432/huk"
AUTH_SECRET=""                     # openssl rand -base64 32
# Base URL for magic links (H-110): next-auth v4 reads ONLY NEXTAUTH_URL
# (AUTH_URL is not read by it). Keep AUTH_TRUST_HOST unset — deriving the
# origin from forwarded headers would allow link poisoning. Must be https://
# in production (S8, fail loud at boot).
NEXTAUTH_URL="http://localhost:3000"
IP_HASH_SALT=""                    # required in production (H-103); fixed dev default otherwise
CLIENT_IP_HEADER="cf-connecting-ip" # the ONLY header a client IP is read from; required in production (H-103)
# Seed audio base URL (H-106); files are served from public/seed/ in dev
SEED_AUDIO_BASE_URL="/seed"
# Mail for magic links (required in production, H-102)
EMAIL_SERVER=""
# Optional first-admin bootstrap: this verified email becomes ADMIN on first
# sign-in while no ADMIN exists (H-102)
INITIAL_ADMIN_EMAIL=""
EMAIL_FROM="HUK <no-reply@example.com>"
# Providers (all calls go through budget.guard())
AUDIUS_API_KEY=""
ACOUSTID_API_KEY=""
AUDD_API_TOKEN=""                  # optional
ASR_API_KEY=""
LLM_API_KEY=""
# Cost fuse: daily caps in micro-USD per provider; exceeding stops the stage, work is queued
BUDGET_DAILY_MICRO_USD_TOTAL="1000000"
PLATFORM_DAILY_SUBMISSION_CAP="10"
AUTHOR_DAILY_SUBMISSION_CAP="2"
INVITE_ONLY="true"
# Retention (days)
RETENTION_LISTEN_EVENTS_DAYS="90"
RETENTION_TRANSCRIPTS_DAYS="90"
