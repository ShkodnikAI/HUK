# deploy/tests/fake-prod.env (H-504) — env fixture for CI rendering of
# deploy/docker-compose.prod.yml (task 7). Every value here is a
# test-only fixture value, not a credential: nothing in this file is a
# real secret and nothing here must ever be used outside a CI render or
# a throw-away drill. The prod stack is validated by rendering it with
# `docker compose --env-file deploy/tests/fake-prod.env config` and by
# scripts/ci/check-prod-compose.mjs (invariants job, .github/workflows/ci.yml).
#
# All keys mirror deploy/.env.production.example 1:1 so a key that
# disappears from the example breaks this file and the CI render — the
# example and the fixture cannot drift apart silently.

POSTGRES_USER="huk"
POSTGRES_PASSWORD="ci-fake-password-not-a-secret-42"
POSTGRES_DB="huk"

AUTH_SECRET="ci-fake-auth-secret-not-a-secret-42"
NEXTAUTH_URL="https://hukradio.com"
IP_HASH_SALT="ci-fake-ip-hash-salt-not-a-secret-42"
CLIENT_IP_HEADER="cf-connecting-ip"

EMAIL_SERVER="smtp://ci-fake-smtp:not-a-secret@smtp.ci-fake.invalid:587"
EMAIL_FROM="HUK <no-reply@hukradio.com>"

SEED_AUDIO_BASE_URL="https://hukradio.com/seed"
AUDIO_CACHE_DIR="/var/lib/huk/audio-cache"

CLOUDFLARE_TUNNEL_TOKEN="ci-fake-tunnel-token-not-a-secret-42"

HUK_WEB_PORT="3100"
HUK_BACKUP_DIR="/tmp/huk-ci-backups"
HUK_IMAGE_TAG="latest"
