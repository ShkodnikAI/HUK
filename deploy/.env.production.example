# HUK production environment (H-504) — copy to deploy/.env, fill EVERY value,
# then `chmod 600 deploy/.env`. deploy/check-env.sh refuses to start the stack
# while a secret is empty or still carries a dev default. The real deploy/.env
# is git-ignored and must never be committed.

# --- Postgres (dedicated to this stack; never published) ---
POSTGRES_USER="huk"
POSTGRES_PASSWORD=""                  # openssl rand -base64 24 (>=16 chars, not a dev value)
POSTGRES_DB="huk"

# --- Core web (S8-validated at boot by src/server/env.ts) ---
AUTH_SECRET=""                        # openssl rand -base64 32
# H-110: next-auth reads ONLY NEXTAUTH_URL; must be a real https:// origin.
NEXTAUTH_URL="https://hukradio.com"
IP_HASH_SALT=""                       # openssl rand -base64 24 (H-103; required in production)
# Trustworthy ONLY while the site is reachable exclusively through Cloudflare.
CLIENT_IP_HEADER="cf-connecting-ip"
# Magic links are the only sign-in — a real SMTP account is required (H-102).
EMAIL_SERVER=""                       # e.g. smtp://user:password@smtp.provider.example:587
EMAIL_FROM="HUK <no-reply@hukradio.com>"
# Optional first-admin bootstrap (H-102): the first verified sign-in with this
# email becomes ADMIN while no ADMIN exists. Leave empty to boot without the
# bootstrap armed (the stack then starts with a disabled placeholder); set a
# real email to arm it. Also changeable later: edit + `deploy/up.sh` again.
INITIAL_ADMIN_EMAIL=""

# --- Seed audio (H-106/H-504): served by the seed-audio container via the tunnel ---
SEED_AUDIO_BASE_URL="https://hukradio.com/seed"

# --- Broadcast audio cache (H-112, D14; required in production) ---
AUDIO_CACHE_DIR="/var/lib/huk/audio-cache"
AUDIO_CACHE_MAX_BYTES="419430400"     # 400 MB

# --- Cloudflare Tunnel: named-tunnel token from the Cloudflare dashboard ---
CLOUDFLARE_TUNNEL_TOKEN=""

# --- Deployment knobs ---
HUK_WEB_PORT="3100"                   # web binds to 127.0.0.1:<port> on the host
HUK_BACKUP_DIR="/srv/huk-backups"     # nightly pg_dump copies live here (mode 600)
# Image tag selector; deploy/update.sh sets it per release. Leave "latest".
HUK_IMAGE_TAG="latest"

# --- Outbound doors (S4) ---
SAFE_FETCH_ALLOW_HTTP="false"
SAFE_FETCH_PORTS="443"

# --- Sources and providers (ship disabled or empty; all calls pass budget.guard, S6) ---
# The optional provider credentials — AUDIUS_API_KEY, ACOUSTID_API_KEY,
# AUDD_API_TOKEN, ASR_API_KEY, LLM_API_KEY (and their *_ENABLED switches —
# see the dev .env.example in the repo root) — are intentionally NOT listed
# here: they ship UNSET in production, which keeps every adapter disabled
# (the compose file defaults them to empty). Add a key only together with
# its ENABLED=true, and only after the budget review (S6).
AUDIUS_ENABLED="false"
AUDD_ENABLED="false"
AUDD_SEGMENTS="4"
FINGERPRINT_STRONG_SCORE="0.9"
SOURCE_FULL_HASH_DAYS="7"
SOURCE_MAX_FAILS="5"
SOURCE_VERIFY_BATCH="20"

# --- Caps and retention ---
BUDGET_DAILY_MICRO_USD_TOTAL="1000000"
PLATFORM_DAILY_SUBMISSION_CAP="10"
AUTHOR_DAILY_SUBMISSION_CAP="2"
INVITE_ONLY="true"
RETENTION_LISTEN_EVENTS_DAYS="90"
RETENTION_TRANSCRIPTS_DAYS="90"
